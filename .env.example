# LLM provider (llm/provider.py) - any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: point at a non-OpenAI, OpenAI-compatible endpoint (e.g. a local server)
LLM_BASE_URL=

# Qdrant (rag/ingest.py)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional: collection the agent searches (agent/retrieve_tool.py). Defaults
# to cyberqa_documents. Only one collection is searched per run -- if you
# ingest into a different --collection (see "Loading documents" in
# README.md), set this to match, or the agent keeps searching the old one.
CYBERQA_COLLECTION=

# Optional: hybrid retrieval weight on the dense signal, 0-1
# (agent/retrieval/hybrid.py). (1 - HYBRID_ALPHA) weights BM25. Defaults to
# 0.5. Only affects retrieval when reranking is off (the default is on);
# once reranked, alpha only affects which candidates survive the
# RERANK_POOL_SIZE cut below, not the final order.
HYBRID_ALPHA=

# Optional: per-signal (dense, BM25) fetch count when reranking, and the
# cap -- cut from their combined union by hybrid_score -- on how many of
# those reach the cross-encoder (agent/retrieval/hybrid.py). Both default
# to 100. The two fetches overlap only ~20% on this corpus, so their union
# is usually well over RERANK_POOL_SIZE; raising it reranks more of that
# union at a small, roughly constant latency cost (the cross-encoder
# batches the whole pool in one forward pass).
FETCH_POOL_SIZE=
RERANK_POOL_SIZE=

# Optional: number of chunks the Retriever fetches per search and hands to
# the Answer Generator (agent/retrieve_tool.py). Defaults to 10.
RETRIEVAL_TOP_K=

# Optional: chunking window, in tokens (rag/chunk.py). Defaults to 200/40.
# Changing these only affects documents ingested afterward; re-ingest into a
# fresh collection to apply a new setting to existing documents.
CHUNK_SIZE=
CHUNK_OVERLAP=

# Optional: embedding model + batch size (rag/embedding.py). Defaults to
# sentence-transformers/all-MiniLM-L6-v2 / 32. Changing EMBEDDING_MODEL
# changes vector dimensions, so use a dedicated Qdrant collection per model
# (see "Loading documents" in README.md) rather than re-ingesting into one
# built with a different model.
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=
